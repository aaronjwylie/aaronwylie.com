# ---- Database ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Connection string used by the API. Host is "db" inside docker-compose, "localhost" for local dev.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the web app).
CORS_ORIGIN=http://localhost:3000
# Simple shared secret protecting write/admin endpoints (e.g. reading contact messages).
ADMIN_TOKEN=change-me-in-production
LOG_LEVEL=info
# Public base path the API is served under (behind nginx it's /api in prod).
# Sets the OpenAPI "servers" URL so Swagger "Try it out" targets the right URL.
API_PUBLIC_PATH=/

# ---- Email (Resend) — optional ----
# When set, contact-form submissions are emailed to CONTACT_TO_EMAIL. Leave blank
# to disable email (submissions are still saved to the database either way).
RESEND_API_KEY=
CONTACT_TO_EMAIL=aaronwyliework@gmail.com
# Verify aaronwylie.com in Resend, then use e.g. "Aaron Wylie <contact@aaronwylie.com>".
# onboarding@resend.dev works with no setup but only delivers to the Resend account owner.
CONTACT_FROM_EMAIL=Aaron Wylie - Website <onboarding@resend.dev>

# ---- Web ----
# Where the browser + server components reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Leave blank to disable
# analytics entirely (no tracking scripts are loaded).
NEXT_PUBLIC_GA_ID=
