# ---- Database ----
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
# Connection string used by the API. Host is "db" inside docker-compose, "localhost" for local dev.
DATABASE_URL=postgres://portfolio:portfolio@localhost:5432/portfolio

# ---- API ----
API_PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed to call the API (the web app).
CORS_ORIGIN=http://localhost:3000
# Simple shared secret protecting write/admin endpoints (e.g. reading contact messages).
ADMIN_TOKEN=change-me-in-production
LOG_LEVEL=info

# ---- Web ----
# Where the browser + server components reach the API.
NEXT_PUBLIC_API_URL=http://localhost:4000
